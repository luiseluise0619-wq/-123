NODE_ENV=production
HOST=127.0.0.1
PORT=3000
ALLOWED_ORIGIN=https://your-domain.example
TRUST_PROXY_HOPS=1
REPORT_EMAIL_ENABLED=false
BREVO_API_KEY=
REPORT_FROM_EMAIL=
REPORT_FROM_NAME=사장님인사이트
# Optional support announcements: select and approve the actual service first.
DATA_GO_KR_KEY=
SUPPORT_API_URL=
# Customer collection remains off until company privacy details and DB setup are complete.
CUSTOMER_DATA_ENABLED=false
CUSTOMER_DATABASE_URL=
CUSTOMER_DATA_KEY=
CUSTOMER_RETENTION_DAYS=
CUSTOMER_PRIVACY_VERSION=
CUSTOMER_CONTROLLER=
CUSTOMER_CONTACT=
# Admin process only. Use a separate random 64-character hex token.
CUSTOMER_ADMIN_TOKEN=
CUSTOMER_ADMIN_PORT=3102
# 관리자 공개 링크를 쓰는 경우 설정
CUSTOMER_ADMIN_PUBLIC=0
# 관리자 DNS/host 허용 목록 (쉼표 구분). 예: admin.your-domain.example,127.0.0.1:3102
#CUSTOMER_ADMIN_ALLOWED_HOSTS=
# 브라우저 호출 origin 허용 목록. 예: https://admin.your-domain.example
#CUSTOMER_ADMIN_ALLOWED_ORIGINS=
