[Unit]
Description=Mysbizon web service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=mysbizon
Group=mysbizon
WorkingDirectory=/opt/mysbizon/current
EnvironmentFile=/etc/mysbizon.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
UMask=0077
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
