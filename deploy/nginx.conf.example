# Include from nginx's http context. Replace domain and TLS paths before use.
limit_req_zone $binary_remote_addr zone=mysbizon_requests:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=mysbizon_connections:10m;
server {
    listen 80;
    server_name your-domain.example;
    return 301 https://your-domain.example$request_uri;
}
server {
    listen 443 ssl;
    server_name your-domain.example;
    ssl_certificate /etc/letsencrypt/live/your-domain.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    client_body_timeout 10s;
    limit_req zone=mysbizon_requests burst=40 nodelay;
    limit_req_status 429;
    limit_conn mysbizon_connections 30;
    # Do not log query strings, form bodies or email addresses.
    access_log off;
    error_log /var/log/nginx/mysbizon-error.log warn;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
        proxy_send_timeout 15s;
    }
}
