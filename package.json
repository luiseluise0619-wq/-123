{
  "name": "mysbizon",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "check:data": "node scripts/validate-data.mjs",
    "build:html": "node scripts/build-assets.mjs && node scripts/build-html.mjs",
    "check:html": "node scripts/build-assets.mjs --check && node scripts/build-html.mjs --check",
    "sums": "node scripts/make-sums.mjs",
    "check:sums": "node scripts/make-sums.mjs --check",
    "build:deploy": "node scripts/build-deploy.mjs"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8"
  }
}
